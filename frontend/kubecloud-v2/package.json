{
  "name": "kubecloud-v2",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "openapi-generator-cli generate && nuxt prepare",
    "prepare": "npm run audit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "audit": "yarn audit --summary --level critical"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@vueuse/nuxt": "14.1.0",
    "axios": "^1.13.2",
    "nuxt": "^4.2.2",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "vuetify": "^3.11.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.12.1",
    "@openapitools/openapi-generator-cli": "^2.25.2",
    "@types/node": "^25.0.2",
    "eslint": "^9.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "sass-embedded": "^1.96.0",
    "typescript": "^5.9.3",
    "vite-plugin-vuetify": "^2.1.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  }
}
