# ============================================
# Network Configuration
# ============================================

# Enable dual-stack networking (IPv4 + IPv6)
# Set to false for IPv4-only clusters
DUAL_STACK=true

# Network interface for Flannel CNI
# - flannel-br: for dual-stack (automatically created)
# - eth0: for IPv4-only setup
K3S_FLANNEL_IFACE=flannel-br

# ============================================
# Cluster Configuration
# ============================================

# Secret token for cluster authentication
# IMPORTANT: Must be identical on all nodes in the cluster
# Generate a secure token: openssl rand -base64 32
K3S_TOKEN="change-me-to-secure-token"

# Data directory for K3s
# Ensure this location has sufficient storage (20GB+ recommended)
K3S_DATA_DIR=/mnt/data

# Unique node name (must be unique within the cluster)
K3S_NODE_NAME=node1

# ============================================
# Node Role Configuration
# ============================================

# Node type: true for server/master, false for agent/worker
MASTER=true

# High availability mode
HA=true

# Cluster URL
# - First master: leave empty (K3S_URL=)
# - Additional masters/workers: https://<first-master-ip>:6443
K3S_URL=

# ============================================
# Kubernetes Configuration
# ============================================

# Kubeconfig file location (auto-generated by K3s)
KUBECONFIG=/etc/rancher/k3s/k3s.yaml

# ============================================
# Optional: Custom CRD Configuration
# ============================================

# Encrypted mnemonic for CRD deployment (if required)
MNEMONIC=""

# Network identifier for CRD (if required)
NETWORK=""

# ============================================
# Configuration Examples
# ============================================

# Example 1: First Master (HA Cluster, Dual-Stack)
DUAL_STACK=true
K3S_FLANNEL_IFACE=flannel-br
K3S_TOKEN="change-me-to-secure-token"
K3S_DATA_DIR=/mnt/data
K3S_NODE_NAME=node1
MASTER=true
HA=true
K3S_URL=
KUBECONFIG=/etc/rancher/k3s/k3s.yaml
MNEMONIC=""
NETWORK=""

# Example 2: First Worker
DUAL_STACK=true
K3S_FLANNEL_IFACE=flannel-br
K3S_TOKEN="change-me-to-secure-token"
K3S_DATA_DIR=/mnt/data
K3S_NODE_NAME=node2
MASTER=false
HA=false
K3S_URL="https://\[58a:691e:e009:33e2:ff0f:0:200:2\]:6443"
KUBECONFIG=/etc/rancher/k3s/k3s.yaml
MNEMONIC=""
NETWORK=""
